set terminal pdfcairo enhanced
set output 'plot.pdf'

set logscale xy
set xlabel "x"
set ylabel "xb"
set xrange [1e-5:1]
set yrange [1e-5:10]
set format x "10^{%T}"
set format y "10^{%T}"

set key bottom left Left reverse samplen 3 spacing 1.2

set style line 1 lc rgb '#1f77b4' dt 1 lw 2 # Solid Blue (fb)
set style line 2 lc rgb '#d62728' dt 2 lw 2 # Dashed Red (ftilde1)
set style line 3 lc rgb '#2ca02c' dt 3 lw 2 # Dotted Green (ftilde2)
set style line 4 lc rgb '#ff7f0e' dt 4 lw 2 # Dash-Dot Orange (ftildeNLO)

# Plotting the data from output.dat
# Column mapping: 1:x, 2:fb, 3:ftilde1, 4:ftilde2 5:ftildeNLO
plot 'out.dat' u 1:2 w lines ls 1 title "f_b", \
	 ''           u 1:3 w lines ls 2 title "f̃_b^{(1)}", \
#	 ''           u 1:4 w lines ls 3 title "f̃_b^{(2)}"
#	 ''           u 1:4 w lines ls 4 title "f̃_b^{(NLO)}"