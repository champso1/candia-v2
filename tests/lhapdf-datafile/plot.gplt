set terminal pdfcairo enhanced notransparent

set border lw 2
set size ratio 0.65

set logscale xy
set xlabel "x"
set ylabel "xc"
set xrange [1e-5:1]
set yrange [1e-4:30]
set format x "10^{%T}"
set format y "10^{%T}"
set title "Charm subtraction and residual PDFs, Q=100 GeV"

set key bottom left Left reverse samplen 3 spacing 1.2

set style line 1 lc rgb 'blue' dt 1 lw 2 # Solid Blue
set style line 2 lc rgb 'red' dt 2 lw 2 # Dashed Red
set style line 3 lc rgb 'dark-green' dt 3 lw 2 # Dotted Dark Green
set style line 4 lc rgb 'orange' dt 4 lw 2 # Dash-Dot Orange
set style line 5 lc rgb 'purple' dt 5 lw 2 # Dot-Dash Purple

set output 'out.pdf'
plot 'out.dat' u 1:2 w lines ls 1 title "f_c", \
 	 ''   u 1:3 w lines ls 2 title "f̃_c^{(NNLO)}", \
 	 ''   u 1:4 w lines ls 3 title "f̃_c^{(N3LO)}", \
	 ''   u 1:5 w lines ls 4 title "{/Symbol d}f_c^{(N3LO)}", \
	 ''   u 1:6 w lines ls 5 title "{/Symbol d}f_c^{(N3LO)}"
