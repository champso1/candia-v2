set terminal pdfcairo enhanced notransparent

set border lw 2
set size ratio 0.65
set rmargin 0
set lmargin 0
set style fill transparent solid 0.3 noborder

file_lo   = "data/lo-forplot.dat"
file_nlo  = "data/nlo-forplot.dat"
file_nnlo = "data/nnlo-forplot.dat"
file_n3lo = "data/n3lo-forplot.dat"

set logscale x
set format x "%.0e"
set grid
set xlabel "x" offset 0,0.7

set style line 1 lc rgb 'blue'        dt 1 lw 1 # Solid Blue
set style line 2 lc rgb 'red'         dt 2 lw 1 # Dashed Red
set style line 3 lc rgb 'dark-green'  dt 3 lw 1 # Dotted Dark Green
set style line 4 lc rgb 'purple'      dt 4 lw 1 # Dash-Dot Purple

set yrange [0:2.5]
set xrange [1e-5:1e-1]
set ylabel "xg(x)/100"
set output "plots/evol-prog-g.pdf"
set title "Gluon PDF using Candia-v2 Evolution at Q=100 GeV"
plot file_lo   using 1:($2/100.0) with lines ls 2 title "LO", \
     file_nlo  using 1:($2/100.0) with lines ls 3 title "NLO", \
     file_nnlo using 1:($2/100.0) with lines ls 4 title "NNLO", \
	 file_n3lo using 1:($2/100.0) with lines ls 1 title "N^{3}LO"

set key left top offset 1.0,0
set xrange [1e-5:1]
set yrange [0:0.6]
set ylabel "xu_{v}(x)"
set output "plots/evol-prog-uv.pdf"
set title "u-valence PDF using Candia-v2 Evolution at Q=100 GeV"
plot file_lo   using 1:15 with lines ls 2 title "LO", \
     file_nlo  using 1:15 with lines ls 3 title "NLO", \
     file_nnlo using 1:15 with lines ls 4 title "NNLO", \
	 file_n3lo using 1:15 with lines ls 1 title "N^{3}LO"
