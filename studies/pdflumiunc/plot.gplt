set terminal pdfcairo enhanced notransparent

set border lw 2
set size ratio 0.65
set rmargin 0
set lmargin 0
set style fill transparent solid 0.3 noborder

infile = "lumis.dat"
outfile = "lumis.pdf"

set logscale x
set yrange [0.8:1.3]
set xrange [1e-3:0.5]
set format x "10^{%T}"
set grid
set key top center

set output outfile
set title "{/:Bold gg Luminosity (√s = 13.6TeV)}"
set xlabel "√(~s{0.5\\^} /s)" offset 0,0.7
set ylabel "Ratio to NNPDF4.0 aN^{3}LO MHOU"
    
plot infile using 1:2 with lines lw 2 dt 2 lc rgb "black" title "CT25", \
	 ''     using 1:($3+$5):($3-$4) with filledcurves lc rgb "blue" notitle, \
	 ''     using 1:($3+$5) with lines lw 0.5 lc rgb "dark-blue" notitle, \
	 ''     using 1:($3-$4) with lines lw 0.5 lc rgb "dark-blue" notitle, \
	 ''     using 1:3 with lines lw 2 lc rgb "dark-blue" title "MSHT20 aN^{3}LO", \
	 ''     using 1:($6+$8):($6-$7) with filledcurves lc rgb "red" notitle, \
	 ''     using 1:($6+$8) with lines lw 0.5 lc rgb "dark-red" notitle, \
	 ''     using 1:($6-$7) with lines lw 0.5 lc rgb "dark-red" notitle, \
	 ''     using 1:6 with lines lw 2 lc rgb "dark-red" title "NNPDF4.0 aN^{3}LO MHOU"

